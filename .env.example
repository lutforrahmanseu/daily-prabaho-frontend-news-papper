# ==============================================================================
# Daily Prabaho (দৈনিক বার্তা প্রবাহ) - Frontend Production Environment Template
# ==============================================================================

# Application Meta
VITE_APP_NAME="দৈনিক বার্তা প্রবাহ (Daily Prabaho)"
VITE_APP_SHORT_NAME="বার্তা প্রবাহ"
VITE_APP_URL="https://dailyprabaho.com"

# API Endpoint Configuration
# Local dev proxy target used by vite.config.ts when frontend & backend run as separate repos:
VITE_BACKEND_URL="http://127.0.0.1:8000"
# In production with unified Nginx reverse proxy, use relative '/api/v1'
# If API is hosted on a dedicated subdomain, use 'https://api.dailyprabaho.com/api/v1'
VITE_API_URL="/api/v1"

# Production Flags
VITE_ENVIRONMENT="production"
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=true

# Optional Telemetry & Error Tracking (e.g. Sentry / GlitchTip)
# VITE_SENTRY_DSN="https://[key]@[ingest-host]/[project-id]"

# AI Studio / Gemini Integration (Injected by platform secret manager)
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
